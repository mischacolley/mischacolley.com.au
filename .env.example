# Birthdates used only to compute my kids' ages at build time (see src/lib/kids.ts).
# Youngest first. "YYYY-MM-DD", or "YYYY-MM" if you'd rather not store the day.
# Server-only — never prefix with NEXT_PUBLIC_. Set the real values in .env.local
# (gitignored) and in the Vercel project's environment variables.
KIDS_BIRTHDATES="2016-01-01,2014-01-01"

# Where the Yarn Chat widget is loaded from (see src/app/layout.tsx).
# Unset is correct for every real build — it falls back to the deployed
# Worker. Set this in .env.local only when running `wrangler dev` locally,
# so the localhost URL can never be committed again.
# NEXT_PUBLIC_YARN_ORIGIN="http://127.0.0.1:8787"
