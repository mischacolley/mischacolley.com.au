# Birthdates used only to compute my kids' ages at build time (see src/lib/kids.ts).
# Youngest first. "YYYY-MM-DD", or "YYYY-MM" if you'd rather not store the day.
# Server-only — never prefix with NEXT_PUBLIC_. Set the real values in .env.local
# (gitignored) and in the Netlify site's environment variables.
KIDS_BIRTHDATES="2016-01-01,2014-01-01"
